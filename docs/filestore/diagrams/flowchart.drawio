    </mxCell>
    <mxCell id="n-u3" value="逐块 PutChunk&#xa;直连存储节点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66BB6A;fontSize=10;" vertex="1" parent="lane-upload">
