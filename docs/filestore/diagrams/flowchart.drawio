<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="分布式文件存储系统 — 文件生命周期流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
      <mxGeometry x="250" y="8" width="600" height="32" as="geometry"/>
    </mxCell>

    <mxCell id="lane-upload" value="上传 upload" style="swimlane;horizontal=0;startSize=110;fillColor=#E8F5E9;strokeColor=#4CAF50;fontStyle=1;fontColor=#2E7D32;html=1;" vertex="1" parent="1">
      <mxGeometry x="0" y="52" width="1080" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="n-u0" value="读本地文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66BB6A;fontSize=11;" vertex="1" parent="lane-upload">
