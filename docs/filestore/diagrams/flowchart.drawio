    <mxCell id="n-u2" value="UploadFile&#xa;登记元数据（拿分配方案）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66BB6A;fontSize=10;" vertex="1" parent="lane-upload">
