    <mxCell id="lane-delete" value="删除 delete" style="swimlane;horizontal=0;startSize=110;fillColor=#FFF3E0;strokeColor=#FF9800;fontStyle=1;fontColor=#E65100;html=1;" vertex="1" parent="1">
